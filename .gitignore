# === ДАНІ ===
# Дані у git не зберігаються: вони великі, змінюються щодня
# і їх завжди можна завантажити заново з data.gov.ua.
# У git лежить тільки код, який їх обробляє.

data/*
!data/README.md
!data/.gitkeep
!data/fixtures/
!data/fixtures/**

# === ПИТОН ===
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# === NODE ===
node_modules/
dist/
build/
.next/
.parcel-cache/

# === СЕРЕДОВИЩЕ І СЕКРЕТИ ===
# Паролі й ключі ніколи не потрапляють у git
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# === ЗІБРАНИЙ САЙТ ===
site/
_site/
public/build/

# === РЕДАКТОРИ І СИСТЕМА ===
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# === ЛОГИ І ТИМЧАСОВЕ ===
*.log
logs/
tmp/
.cache/

# Приватні тексти, контексти й локальні бази (також поза data/).
FABULA_REZULTAT.txt
*.db
*.db.gz
*.db-*
*.sqlite*
*.rtf
private/

# === ЗАГЛУШКА (ZAVDANNYA-02) ===
# Вихідні файли заглушки зберігаються в git; рядок `site/` вище лишається для
# інших зібраних сайтів. Справжній config.js (з адресою сховища) — лише під час
# збирання, у git не потрапляє.
!site/
site/*
!site/zahlushka/
site/zahlushka/config.js

# === ГРА (ZAVDANNYA-07) ===
# Вихідні файли гри «Вгадай, де це було» зберігаються в git; справжня колода
# (koloda.json з конвеєра) — лише під час збирання, у git не потрапляє.
!site/hra/
site/hra/koloda.json

# === САЙТ (ZAVDANNYA-10) ===
# Збирач сайту й спільні файли сторінок — у git; зібраний сайт (_site/) — ні.
!site/zibraty_sait.py
!site/sait/
